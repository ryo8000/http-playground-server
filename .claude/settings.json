{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -fr:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git stash)",
      "Bash(git stash pop:*)",
      "Bash(git stash push:*)",
      "Bash(git switch:*)",
      "Bash(node -e:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(yarn upgrade:*)"
    ],
    "allow": [
      "Skill(new-endpoint)",
      "Skill(verify)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(git status:*)",
      "Bash(git tag -l:*)",
      "Bash(ls:*)",
      "Bash(node dist/server.js)",
      "Bash(npm info:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(yarn audit)",
      "Bash(yarn build)",
      "Bash(yarn dev)",
      "Bash(yarn format:*)",
      "Bash(yarn format:check:*)",
      "Bash(yarn install:*)",
      "Bash(yarn jest:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint:fix:*)",
      "Bash(yarn outdated)",
      "Bash(yarn test:*)",
      "Bash(yarn test:coverage:*)",
      "Bash(yarn test:e2e:*)",
      "Bash(yarn typecheck)",
      "Bash(yarn verify:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false
}
